rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserDocument(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Registration creates this document; profile screens read and update it.
      // Profile deletion is intentionally not exposed by the application.
      allow read: if ownsUserDocument(userId);
      allow create, update: if ownsUserDocument(userId)
        && request.resource.data.uid == userId;

      match /watchlist/{movieId} {
        allow read, create, update, delete: if ownsUserDocument(userId);
      }
    }
  }
}
